pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'spring-locket_elasticsearch'
        DOCKER_PORT = 8083

        EC2_USER = credentials('EC2_USER')
        EC2_IP = credentials('EC2_IP')
        SSH_KEY = credentials('SSH_KEY')

        ELASTICSEARCH_URIS = credentials('ELASTICSEARCH_URIS')
        ELASTICSEARCH_USERNAME = credentials('ELASTICSEARCH_USERNAME')
        ELASTICSEARCH_PASSWORD = credentials('ELASTICSEARCH_PASSWORD')
        KAFKA_BOOTSTRAP_SERVERS = credentials('KAFKA_BOOTSTRAP_SERVERS')

        JAVA_HOME = '/opt/java/openjdk'
        GRADLE_HOME = '/opt/gradle/gradle-8.7'
        PATH = "${JAVA_HOME}/bin:${GRADLE_HOME}/bin:${env.PATH}"
    }

    tools {
        jdk 'JDK17'
        gradle 'Gradle 8.7'
    }

    stages {
        stage('Clone Repository') {
            steps {
                echo '🔄 Cloning the repository...'
                git branch: 'backend',
                    url: 'https://lab.ssafy.com/s12-fintech-finance-sub1/S12P21D204.git',
                    credentialsId: 'GitLab-PAT'
            }
        }

        stage('Build Application') {
            steps {
                echo '🔨 Building LocketElasticSearch...'
                dir('backend/LocketElasticSearch') {
                    sh 'gradle clean build -x test'
                    sh 'ls -al $(pwd)/build/libs'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                echo '🐳 Building Docker image...'
                dir('backend/LocketElasticSearch') {
                    sh 'cp build/libs/LocketElasticSearch-0.0.1-SNAPSHOT.jar .'
                    sh 'docker build -t ${DOCKER_IMAGE}:latest .'
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                echo '📤 Pushing Docker image to Docker Hub...'
                withCredentials([usernamePassword(
                    credentialsId: 'DockerHub_PAT',
                    usernameVariable: 'DOCKERHUB_USERNAME',
                    passwordVariable: 'DOCKERHUB_TOKEN'
                )]) {
                    sh '''
                        docker login -u ${DOCKERHUB_USERNAME} -p ${DOCKERHUB_TOKEN}
                        docker tag ${DOCKER_IMAGE}:latest ${DOCKERHUB_USERNAME}/${DOCKER_IMAGE}:latest
                        docker push ${DOCKERHUB_USERNAME}/${DOCKER_IMAGE}:latest
                    '''
                }
            }
        }

        stage('Deploy to Docker Swarm') {
            steps {
                echo '🚀 Deploying to Docker Swarm on EC2...'
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'SSH_KEY',
                        keyFileVariable: 'EC2_SSH_KEY_FILE',
                        usernameVariable: 'EC2_USER'
                    ),
                    string(credentialsId: 'EC2_IP', variable: 'EC2_IP'),
                    usernamePassword(
                        credentialsId: 'DockerHub_PAT',
                        usernameVariable: 'DOCKERHUB_USERNAME',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    ),
                    string(credentialsId: 'ELASTICSEARCH_URIS', variable: 'ELASTICSEARCH_URIS'),
                    string(credentialsId: 'ELASTICSEARCH_USERNAME', variable: 'ELASTICSEARCH_USERNAME'),
                    string(credentialsId: 'ELASTICSEARCH_PASSWORD', variable: 'ELASTICSEARCH_PASSWORD'),
                    string(credentialsId: 'KAFKA_BOOTSTRAP_SERVERS', variable: 'KAFKA_BOOTSTRAP_SERVERS')
                ]) {
                    sh '''
                        echo "🚀 Updating Docker Swarm service..."
                        ssh -o StrictHostKeyChecking=no -i $EC2_SSH_KEY_FILE $EC2_USER@$EC2_IP \
                            "docker service update \
                                --env-rm SPRING_PROFILES_ACTIVE \
                                --env-add SPRING_PROFILES_ACTIVE=prod \
                                --env-add ELASTICSEARCH_URIS=$ELASTICSEARCH_URIS \
                                --env-add ELASTICSEARCH_USERNAME=$ELASTICSEARCH_USERNAME \
                                --env-add ELASTICSEARCH_PASSWORD=$ELASTICSEARCH_PASSWORD \
                                --env-add KAFKA_BOOTSTRAP_SERVERS=$KAFKA_BOOTSTRAP_SERVERS \
                                --image $DOCKERHUB_USERNAME/${DOCKER_IMAGE}:latest \
                                ${DOCKER_IMAGE}"
                    '''
                }
            }
        }

    }

    post {
        always {
            echo '🧹 Cleaning workspace...'
            cleanWs()
        }
        success {
            echo '✅ Deployment successful!'
        }
        failure {
            echo '❌ Deployment failed.'
        }
    }
}
