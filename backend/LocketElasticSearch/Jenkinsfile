pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'spring-locket-elasticsearch'
        DOCKER_CONTAINER = 'spring-locket-elasticsearch'
        DOCKER_PORT = 8083
        DOCKER_PATH = '/home/ubuntu/docker'  // EC2 서버의 Docker 저장 경로

        EC2_USER = credentials('EC2_USER')
        EC2_IP = credentials('EC2_IP')
        SSH_KEY = credentials('SSH_KEY')

        ELASTICSEARCH_URIS = credentials('ELASTICSEARCH_URIS')
        ELASTICSEARCH_USERNAME = credentials('ELASTICSEARCH_USERNAME')
        ELASTICSEARCH_PASSWORD = credentials('ELASTICSEARCH_PASSWORD')

        KAFKA_BOOTSTRAP_SERVERS = credentials('KAFKA_BOOTSTRAP_SERVERS')

        JAVA_HOME = '/opt/java/openjdk'
        GRADLE_HOME = '/opt/gradle/gradle-8.7'
        PATH = "${JAVA_HOME}/bin:${GRADLE_HOME}/bin:${env.PATH}"
    }

    tools {
        jdk 'JDK17'
        gradle 'Gradle 8.7'
    }

    stages {
        stage('Clone Repository') {
            steps {
                echo '🔄 Cloning the repository...'
                git branch: 'backend',
                    url: 'https://lab.ssafy.com/s12-fintech-finance-sub1/S12P21D204.git',
                    credentialsId: 'GitLab-PAT'
            }
        }
        stage('Build Application') {
            steps {
                echo '🔨 Building the application with Gradle Wrapper...'
                dir('backend/LocketElasticSearch') {
                    sh 'gradle clean build -x test'  // 테스트 제외하고 빌드
                    sh 'ls -al $(pwd)/build/libs'
                }
            }
        }
        stage('Build Docker Image') {
            steps {
                echo '🐳 Building the Docker image...'
                dir('backend/LocketElasticSearch') {
                    sh 'cp build/libs/LocketElasticSearch-0.0.1-SNAPSHOT.jar .'
                    sh 'docker build -t ${DOCKER_IMAGE}:latest .'
                }
            }
        }
        stage('Save and Transfer Docker Image') {
            steps {
                echo '📦 Saving and transferring Docker image to EC2...'
                sh """
                docker save ${DOCKER_IMAGE}:latest | gzip > LocketElasticSearch-0.0.1-SNAPSHOT.tar.gz
                """
                sshPublisher(publishers: [
                    sshPublisherDesc(
                        configName: 'EC2-Server',
                        transfers: [
                            sshTransfer(
                                sourceFiles: 'LocketElasticSearch-0.0.1-SNAPSHOT.tar.gz'
                            )
                        ]
                    )
                ])
            }
        }
        stage('Deploy to EC2') {
            steps {
                echo '🚀 Deploying LocketElasticSearch on EC2...'
                sshPublisher(publishers: [
                    sshPublisherDesc(
                        configName: 'EC2-Server',
                        transfers: [
                            sshTransfer(
                                execCommand: """
                                    mkdir -p ${DOCKER_PATH}
                                    docker stop ${DOCKER_CONTAINER} || true
                                    docker rm ${DOCKER_CONTAINER} || true
                                    docker rmi ${DOCKER_IMAGE}:latest || true
                                    docker load < ${DOCKER_PATH}/LocketElasticSearch-0.0.1-SNAPSHOT.tar.gz
                                    docker run -d --name ${DOCKER_CONTAINER} \
                                      -p ${DOCKER_PORT}:${DOCKER_PORT} \
                                      -e SPRING_PROFILES_ACTIVE=prod \
                                      -e SERVER_PORT=${DOCKER_PORT} \
                                      -e ELASTICSEARCH_URIS=${ELASTICSEARCH_URIS} \
                                      -e ELASTICSEARCH_USERNAME=${ELASTICSEARCH_USERNAME} \
                                      -e ELASTICSEARCH_PASSWORD=${ELASTICSEARCH_PASSWORD} \
                                      -e KAFKA_BOOTSTRAP_SERVERS=${KAFKA_BOOTSTRAP_SERVERS} \
                                      ${DOCKER_IMAGE}:latest
                                """.stripIndent()
                            )
                        ]
                    )
                ])
            }
        }
    }

    post {
        always {
            echo '🧹 Cleaning workspace...'
            cleanWs()
        }
        success {
            echo '✅ Deployment successful!'
        }
        failure {
            echo '❌ Deployment failed.'
        }
    }
}
