pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git credentialsId: 'GitLab-PAT',
                    branch: 'backend',
                    url: 'https://lab.ssafy.com/s12-fintech-finance-sub1/S12P21D204.git'
            }
        }

        stage('Detect Changed Services') {
            steps {
                script {
                    // 원격 브랜치 최신 상태로 갱신
                    sh 'git fetch origin backend'

                    // 변경된 파일 목록 추출
                    def changes = sh(script: "git diff --name-only origin/backend HEAD", returnStdout: true).trim().split('\n')
                    echo "Changed files: ${changes.join(', ')}"

                    // 디렉토리별로 변경 감지 및 빌드 트리거
                    if (changes.any { it.startsWith("backend/LocketApiGateway/") }) {
                        build job: 'backend-api-gateway'
                    }
                    if (changes.any { it.startsWith("backend/LocketDiscovery/") }) {
                        build job: 'backend-discovery'
                    }
                    if (changes.any { it.startsWith("backend/LocketElasticSearch/") }) {
                        build job: 'backend-elasticsearch'
                    }
                    if (changes.any { it.startsWith("backend/LocketPaymentService/") }) {
                        build job: 'backend-payment'
                    }
                    if (changes.any { it.startsWith("backend/LocketUserService/") }) {
                        build job: 'backend-user'
                    }
                }
            }
        }
    }
}
