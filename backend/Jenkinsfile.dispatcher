pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git credentialsId: 'GitLab-PAT',
                        branch: 'backend',
                        url: 'https://lab.ssafy.com/s12-fintech-finance-sub1/S12P21D204.git'
            }
        }

        stage('Detect Changed Services') {
            steps {
                withCredentials([usernamePassword(
                        credentialsId: 'GitLab-USER-TOKEN',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_PASSWORD'
                )]) {
                    script {
                        // ===== 1. 클로저 정의: 서비스 변경 감지 후 순차 빌드 =====
                        def triggerBuilds = { changes ->
                            if (changes.any { it.startsWith("backend/LocketApiGateway/") }) {
                                build job: 'backend-api-gateway'
                            }
                            if (changes.any { it.startsWith("backend/LocketDiscovery/") }) {
                                build job: 'backend-discovery'
                            }
                            if (changes.any { it.startsWith("backend/LocketElasticSearch/") }) {
                                build job: 'backend-elasticsearch'
                            }
                            if (changes.any { it.startsWith("backend/LocketPaymentService/") }) {
                                build job: 'backend-payment'
                            }
                            if (changes.any { it.startsWith("backend/LocketUserService/") }) {
                                build job: 'backend-user'
                            }
                        }

                        // ===== 2. 워크스페이스 정리 및 최신 fetch =====
                        sh 'git clean -fdx'
                        sh "git fetch https://${GIT_USERNAME}:${GIT_PASSWORD}@lab.ssafy.com/s12-fintech-finance-sub1/S12P21D204.git backend"

                        // ===== 3. 병합 커밋 여부 확인 =====
                        def parentCount = sh(script: "git rev-list --count --parents -n 1 HEAD | awk '{print NF-1}'", returnStdout: true).trim().toInteger()
                        def currentCommit = sh(script: "git rev-parse HEAD", returnStdout: true).trim()

                        // ===== 4. 변경 파일 목록 추출 및 빌드 실행 =====
                        def changes = []

                        if (parentCount > 1) {
                            // 병합 커밋: 두 부모 모두 비교
                            def parent1 = sh(script: "git rev-parse HEAD^1", returnStdout: true).trim()
                            def parent2 = sh(script: "git rev-parse HEAD^2", returnStdout: true).trim()

                            def changes1 = sh(script: "git diff --name-only ${parent1} ${currentCommit}", returnStdout: true).trim().split('\n')
                            def changes2 = sh(script: "git diff --name-only ${parent2} ${currentCommit}", returnStdout: true).trim().split('\n')

                            changes = (changes1 + changes2).toSet().toList()
                            echo "Changed files (merge): ${changes.join(', ')}"
                        } else {
                            // 일반 커밋: 한 부모와 비교
                            def parentCommit = sh(script: "git rev-parse HEAD^1", returnStdout: true).trim()
                            changes = sh(script: "git diff --name-only ${parentCommit} ${currentCommit}", returnStdout: true).trim().split('\n')
                            echo "Changed files: ${changes.join(', ')}"
                        }

                        // ===== 5. 자동 빌드 트리거 실행 =====
                        triggerBuilds(changes)
                    }
                }
            }
        }
    }
}
