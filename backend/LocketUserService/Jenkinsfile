pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'spring-locket-user-service'
        DOCKER_PORT = 8082

        EC2_USER = credentials('EC2_USER')
        EC2_IP = credentials('EC2_IP')
        SSH_KEY = credentials('SSH_KEY')

        DB_URL_USER = credentials('DB_URL_USER')
        DB_USERNAME = credentials('DB_USERNAME')
        DB_PASSWORD = credentials('DB_PASSWORD')

        KAFKA_BOOTSTRAP_SERVERS = credentials('KAFKA_BOOTSTRAP_SERVERS')

        JAVA_HOME = '/opt/java/openjdk'
        GRADLE_HOME = '/opt/gradle/gradle-8.7'
        PATH = "${JAVA_HOME}/bin:${GRADLE_HOME}/bin:${env.PATH}"
    }

    tools {
        jdk 'JDK17'
        gradle 'Gradle 8.7'
    }

    stages {
        stage('Clone Repository') {
            steps {
                echo '🔄 Cloning the repository...'
                git branch: 'backend',
                    url: 'https://lab.ssafy.com/s12-fintech-finance-sub1/S12P21D204.git',
                    credentialsId: 'GitLab-PAT'
            }
        }

        stage('Build Application') {
            steps {
                echo '🔨 Building the application with Gradle Wrapper...'
                dir('backend/LocketUserService') {
                    sh 'gradle clean build -x test'
                    sh 'ls -al $(pwd)/build/libs'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                echo '🐳 Building the Docker image...'
                dir('backend/LocketUserService') {
                    sh 'cp build/libs/LocketUserService-0.0.1-SNAPSHOT.jar .'
                    sh 'docker build -t ${DOCKER_IMAGE}:latest .'
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                echo '📤 Pushing Docker image to Docker Hub...'
                withCredentials([usernamePassword(
                    credentialsId: 'DockerHub_PAT',
                    usernameVariable: 'DOCKERHUB_USERNAME',
                    passwordVariable: 'DOCKERHUB_TOKEN'
                )]) {
                    sh '''
                        docker login -u ${DOCKERHUB_USERNAME} -p ${DOCKERHUB_TOKEN}
                        docker tag ${DOCKER_IMAGE}:latest ${DOCKERHUB_USERNAME}/${DOCKER_IMAGE}:latest
                        docker push ${DOCKERHUB_USERNAME}/${DOCKER_IMAGE}:latest
                    '''
                }
            }
        }

        stage('Deploy to Docker Swarm') {
            steps {
                echo '🚀 Deploying User Service to Docker Swarm on EC2...'
                sshPublisher(publishers: [
                    sshPublisherDesc(
                        configName: 'EC2-Server',
                        transfers: [
                            sshTransfer(
                                execCommand: '''
                                    echo "🛠️ Creating service ${DOCKER_IMAGE} on Docker Swarm"
                                    docker service create --name ${DOCKER_IMAGE} \
                                        -p ${DOCKER_PORT}:${DOCKER_PORT} \
                                        -e SPRING_PROFILES_ACTIVE=prod \
                                        -e SERVER_PORT=${DOCKER_PORT} \
                                        -e DB_URL_USER=${DB_URL_USER} \
                                        -e DB_USERNAME=${DB_USERNAME} \
                                        -e DB_PASSWORD=${DB_PASSWORD} \
                                        -e KAFKA_BOOTSTRAP_SERVERS=${KAFKA_BOOTSTRAP_SERVERS} \
                                        ${DOCKERHUB_USERNAME}/${DOCKER_IMAGE}:latest
                                '''.stripIndent()
                            )
                        ]
                    )
                ])
            }
        }
    }

    post {
        always {
            echo '🧹 Cleaning workspace...'
            cleanWs()
        }
        success {
            echo '✅ Deployment successful!'
        }
        failure {
            echo '❌ Deployment failed.'
        }
    }
}
