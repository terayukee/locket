<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom Shadow Layer -->
    <item android:bottom="2dp" android:right="2dp" android:left="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#10000000"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>

    <!-- Slightly Darker Shadow Layer -->
    <item android:bottom="3dp" android:right="3dp" android:left="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#08000000"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>

    <!-- Background Layer -->
    <item android:bottom="4dp" android:right="4dp" android:left="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
</layer-list>