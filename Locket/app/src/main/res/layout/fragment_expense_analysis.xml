<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.finance.fragments.analysis.ExpenseAnalysisFragment">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleX="-1"
            android:src="@drawable/ic_all_arrow"
            android:padding="16dp"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_year_month"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:fontFamily="@font/pretendard_regular"
            android:letterSpacing="-0.02"
            android:textColor="@color/text"
            android:textSize="20sp"
            app:layout_constraintEnd_toStartOf="@+id/iv_prev_month_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_back"
            tools:text="2025년 3월" />

        <ImageView
            android:id="@+id/iv_prev_month_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_finance_arrow_left"
            app:layout_constraintDimensionRatio="1"
            android:paddingVertical="8dp"
            android:paddingEnd="4dp"
            android:paddingStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_next_month_icon"
            app:layout_constraintEnd_toStartOf="@+id/iv_next_month_icon"
            app:layout_constraintTop_toTopOf="@+id/iv_next_month_icon" />

        <ImageView
            android:id="@+id/iv_next_month_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_finance_arrow_right"
            android:paddingVertical="8dp"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_year_month"
            app:layout_constraintDimensionRatio="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_year_month" />

        <TextView
            android:id="@+id/textview1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_regular"
            android:text="지출"
            android:textColor="#464646"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_payment_data"
            app:layout_constraintStart_toStartOf="@+id/tv_year_month"
            app:layout_constraintTop_toTopOf="@+id/tv_payment_data" />

        <TextView
            android:id="@+id/tv_payment_data"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/pretendard_bold"
            android:letterSpacing="-0.02"
            android:textColor="@color/text"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="@+id/iv_next_month_icon"
            app:layout_constraintStart_toEndOf="@+id/textview1"
            app:layout_constraintTop_toBottomOf="@+id/tv_year_month"
            tools:text="463,000원" />

        <ImageView
            android:id="@+id/iv_division1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bottom_sheet_division"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_payment_data"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tv_category_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/pretendard_bold"
            android:letterSpacing="-0.02"
            android:text="카테고리별 지출"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_division1" />

        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/pie_chart"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="@+id/tv_category_title"
            app:layout_constraintStart_toStartOf="@+id/tv_category_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_category_title" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_category_payment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            app:layout_constraintEnd_toEndOf="@+id/pie_chart"
            app:layout_constraintStart_toStartOf="@+id/pie_chart"
            app:layout_constraintTop_toBottomOf="@+id/pie_chart" />

        <ImageView
            android:id="@+id/iv_division2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bottom_sheet_division"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@+id/rv_category_payment"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tv_pattern_analysis"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_bold"
            android:letterSpacing="-0.02"
            android:text="AI 소비패턴 분석"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="@+id/tv_payment_data"
            app:layout_constraintStart_toStartOf="@+id/textview1"
            app:layout_constraintTop_toBottomOf="@+id/iv_division2" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
