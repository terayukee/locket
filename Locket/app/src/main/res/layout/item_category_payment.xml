<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/iv_bullet"
        android:layout_width="8dp"
        android:layout_height="8dp"
        app:layout_constraintDimensionRatio="1"
        android:background="@drawable/ic_finance_budget_bullet_filled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_category"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_category"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:letterSpacing="-0.02"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_category_percent"
        app:layout_constraintStart_toEndOf="@+id/iv_bullet"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="쇼핑" />

    <TextView
        android:id="@+id/tv_category_percent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:letterSpacing="-0.02"
        app:layout_constraintBottom_toBottomOf="@+id/tv_category"
        app:layout_constraintEnd_toStartOf="@+id/tv_payment_amount"
        app:layout_constraintStart_toEndOf="@+id/tv_category"
        app:layout_constraintTop_toTopOf="@+id/tv_category"
        tools:text="46%" />

    <TextView
        android:id="@+id/tv_payment_amount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:letterSpacing="-0.02"
        app:layout_constraintBottom_toBottomOf="@+id/tv_category_percent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_category_percent"
        app:layout_constraintTop_toTopOf="@+id/tv_category_percent"
        tools:text="159,236원" />

</androidx.constraintlayout.widget.ConstraintLayout>