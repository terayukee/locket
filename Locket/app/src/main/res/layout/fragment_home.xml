<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.HomeFragment"
    android:background="@color/background"
    android:paddingTop="16dp"
    android:paddingHorizontal="24dp">

    <ImageView
        android:id="@+id/logo_locket"
        android:layout_width="108dp"
        android:layout_height="34dp"
        android:src="@drawable/logo_home_locket"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ic_notification"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_home_bell_off"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/ic_profile"
        app:layout_constraintEnd_toStartOf="@+id/ic_profile"
        app:layout_constraintTop_toTopOf="@+id/ic_profile" />

    <ImageView
        android:id="@+id/ic_profile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_home_profile"
        android:paddingVertical="4dp"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/logo_locket"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/logo_locket" />

    <TextView
        android:id="@+id/tv_user_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:fontFamily="@font/pretendard_bold"
        android:letterSpacing="-0.02"
        android:textColor="@color/text"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo_locket"
        tools:text="은주님" />

    <TextView
        android:id="@+id/tv_budget_ai_feedback"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="목표 소비 금액 70% 달성 🎯"
        android:textColor="@color/primary"
        android:textSize="24sp"
        android:fontFamily="@font/pretendard_bold"
        android:letterSpacing="-0.02"
        app:layout_constraintEnd_toEndOf="@+id/ic_profile"
        app:layout_constraintStart_toStartOf="@+id/tv_user_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_user_name" />

    <ImageView
        android:id="@+id/iv_payment_card_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_home_card"
        app:layout_constraintDimensionRatio="2.81"
        app:layout_constraintEnd_toEndOf="@+id/tv_budget_ai_feedback"
        app:layout_constraintStart_toStartOf="@+id/tv_budget_ai_feedback"
        app:layout_constraintTop_toBottomOf="@+id/tv_budget_ai_feedback" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:text="이번 달 지출"
        android:textColor="@color/text"
        android:textSize="20sp"
        android:fontFamily="@font/pretendard_bold"
        app:layout_constraintStart_toStartOf="@+id/iv_payment_card_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_payment_card_bg" />

    <ImageView
        android:id="@+id/btn_payment_move"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:paddingTop="20dp"
        android:src="@drawable/ic_all_arrow"
        android:paddingHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/textView"
        app:layout_constraintStart_toEndOf="@+id/textView"
        app:layout_constraintTop_toTopOf="@+id/textView" />

    <ImageView
        android:id="@+id/iv_payment_icon_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:background="@drawable/bg_home_icon"
        app:layout_constraintBottom_toBottomOf="@+id/iv_payment_card_bg"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintHeight_percent="0.057"
        app:layout_constraintVertical_bias="0.4"
        app:layout_constraintStart_toStartOf="@+id/textView"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <ImageView
        android:id="@+id/iv_payment_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_home_payment"
        app:layout_constraintBottom_toBottomOf="@+id/iv_payment_icon_bg"
        app:layout_constraintEnd_toEndOf="@+id/iv_payment_icon_bg"
        app:layout_constraintStart_toStartOf="@+id/iv_payment_icon_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_payment_icon_bg" />

    <TextView
        android:id="@+id/tv_payment_data"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:letterSpacing="-0.02"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:fontFamily="@font/pretendard_semi_bold"
        app:layout_constraintBottom_toTopOf="@+id/tv_payment_feedback"
        app:layout_constraintEnd_toStartOf="@+id/btn_analysis"
        app:layout_constraintStart_toEndOf="@+id/iv_payment_icon_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_payment_icon_bg"
        tools:text="200,000원" />

    <TextView
        android:id="@+id/tv_payment_feedback"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:letterSpacing="-0.02"
        android:textColor="@color/text"
        android:textSize="12sp"
        android:fontFamily="@font/pretendard_medium"
        app:layout_constraintBottom_toBottomOf="@+id/iv_payment_icon_bg"
        app:layout_constraintEnd_toStartOf="@+id/btn_analysis"
        app:layout_constraintStart_toEndOf="@+id/iv_payment_icon_bg"
        app:layout_constraintTop_toBottomOf="@+id/tv_payment_data"
        tools:text="지난 달보다 109만원 덜 썼어요" />

    <ImageView
        android:id="@+id/btn_analysis"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_home_btn_small"
        app:layout_constraintBottom_toBottomOf="@+id/iv_payment_icon_bg"
        app:layout_constraintEnd_toEndOf="@+id/iv_payment_card_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_payment_icon_bg" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="분석하기"
        android:textSize="14sp"
        android:textColor="@color/white"
        android:letterSpacing="-0.02"
        app:layout_constraintBottom_toBottomOf="@+id/btn_analysis"
        app:layout_constraintEnd_toEndOf="@+id/btn_analysis"
        app:layout_constraintStart_toStartOf="@+id/btn_analysis"
        app:layout_constraintTop_toTopOf="@+id/btn_analysis" />

    <ImageView
        android:id="@+id/iv_budget_card_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_home_card"
        android:layout_marginTop="12dp"
        app:layout_constraintDimensionRatio="2.81"
        app:layout_constraintEnd_toEndOf="@+id/tv_budget_ai_feedback"
        app:layout_constraintStart_toStartOf="@+id/tv_budget_ai_feedback"
        app:layout_constraintTop_toBottomOf="@+id/iv_payment_card_bg" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:text="이번 달 목표"
        android:textColor="@color/text"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/iv_budget_card_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_budget_card_bg" />

    <ImageView
        android:id="@+id/btn_budget_move"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:paddingTop="20dp"
        android:src="@drawable/ic_all_arrow"
        android:paddingHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/textView2"
        app:layout_constraintStart_toEndOf="@+id/textView2"
        app:layout_constraintTop_toTopOf="@+id/textView2" />

    <ImageView
        android:id="@+id/iv_budget_icon_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:background="@drawable/bg_home_icon"
        app:layout_constraintBottom_toBottomOf="@+id/iv_budget_card_bg"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintHeight_percent="0.057"
        app:layout_constraintVertical_bias="0.4"
        app:layout_constraintStart_toStartOf="@+id/textView2"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <ImageView
        android:id="@+id/iv_budget_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_home_budget"
        app:layout_constraintBottom_toBottomOf="@+id/iv_budget_icon_bg"
        app:layout_constraintEnd_toEndOf="@+id/iv_budget_icon_bg"
        app:layout_constraintStart_toStartOf="@+id/iv_budget_icon_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_budget_icon_bg" />

    <TextView
        android:id="@+id/tv_budget_no_goal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:fontFamily="@font/pretendard_medium"
        android:letterSpacing="-0.02"
        android:text="이번 달 목표를 등록해주세요"
        android:textColor="@color/text"
        android:textSize="14sp"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_budget_icon_bg"
        app:layout_constraintEnd_toStartOf="@+id/btn_analysis"
        app:layout_constraintStart_toEndOf="@+id/iv_budget_icon_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_budget_icon_bg" />

    <TextView
        android:id="@+id/tv_budget_data"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:letterSpacing="-0.02"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:fontFamily="@font/pretendard_semi_bold"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_budget_feedback"
        app:layout_constraintEnd_toStartOf="@+id/btn_analysis"
        app:layout_constraintStart_toEndOf="@+id/iv_budget_icon_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_budget_icon_bg"
        tools:text="200,000원" />

    <TextView
        android:id="@+id/tv_budget_feedback"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:letterSpacing="-0.02"
        android:textColor="@color/text"
        android:textSize="12sp"
        android:fontFamily="@font/pretendard_medium"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_budget_icon_bg"
        app:layout_constraintEnd_toStartOf="@+id/btn_analysis"
        app:layout_constraintStart_toEndOf="@+id/iv_budget_icon_bg"
        app:layout_constraintTop_toBottomOf="@+id/tv_budget_data"
        tools:text="10만원 남았습니다" />

    <ImageView
        android:id="@+id/iv_banner"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/banner_home"
        android:layout_marginTop="12dp"
        app:layout_constraintDimensionRatio="7.24"
        app:layout_constraintEnd_toEndOf="@+id/iv_budget_card_bg"
        app:layout_constraintStart_toStartOf="@+id/iv_budget_card_bg"
        app:layout_constraintTop_toBottomOf="@+id/iv_budget_card_bg" />


    <ImageView
        android:id="@+id/iv_receipt_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_home_card_square"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintEnd_toStartOf="@+id/iv_character_bg"
        app:layout_constraintStart_toStartOf="@+id/iv_banner"
        app:layout_constraintTop_toBottomOf="@+id/iv_banner" />

    <ImageView
        android:id="@+id/iv_receipt_icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/ic_home_receipt"
        app:layout_constraintDimensionRatio="1"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_receipt"
        app:layout_constraintEnd_toEndOf="@+id/iv_receipt_bg"
        app:layout_constraintStart_toStartOf="@+id/iv_receipt_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_receipt_bg" />

    <TextView
        android:id="@+id/tv_receipt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:letterSpacing="-0.02"
        android:text="영수증 등록"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:textAlignment="center"
        android:fontFamily="@font/pretendard_medium"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@+id/iv_receipt_icon"
        app:layout_constraintBottom_toBottomOf="@+id/iv_receipt_bg"
        app:layout_constraintStart_toStartOf="@+id/iv_receipt_icon"
        app:layout_constraintEnd_toEndOf="@+id/iv_receipt_icon"/>

    <ImageView
        android:id="@+id/iv_character_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:background="@drawable/bg_home_card_square"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintEnd_toEndOf="@+id/iv_banner"
        app:layout_constraintStart_toEndOf="@+id/iv_receipt_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_receipt_bg" />

    <ImageView
        android:id="@+id/iv_character_icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/ic_home_character"
        app:layout_constraintBottom_toTopOf="@+id/tv_character"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintEnd_toEndOf="@+id/iv_character_bg"
        app:layout_constraintStart_toStartOf="@+id/iv_character_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_character_bg" />

    <TextView
        android:id="@+id/tv_character"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:letterSpacing="-0.02"
        android:text="캐릭터 키우기"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:textAlignment="center"
        android:fontFamily="@font/pretendard_medium"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@+id/iv_character_icon"
        app:layout_constraintBottom_toBottomOf="@+id/iv_character_bg"
        app:layout_constraintStart_toStartOf="@+id/iv_character_icon"
        app:layout_constraintEnd_toEndOf="@+id/iv_character_icon"/>

</androidx.constraintlayout.widget.ConstraintLayout>