<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.finance.FinanceFragment">

    <TextView
        android:id="@+id/tv_year_month"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/pretendard_regular"
        android:letterSpacing="-0.02"
        android:textColor="@color/text"
        android:textSize="20sp"
        app:layout_constraintEnd_toStartOf="@+id/iv_prev_month_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="2025년 3월" />

    <ImageView
        android:id="@+id/iv_prev_month_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_finance_arrow_left"
        app:layout_constraintDimensionRatio="1"
        android:paddingVertical="8dp"
        android:paddingEnd="4dp"
        android:paddingStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_next_month_icon"
        app:layout_constraintEnd_toStartOf="@+id/iv_next_month_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_next_month_icon" />

    <ImageView
        android:id="@+id/iv_next_month_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_finance_arrow_right"
        android:paddingVertical="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_year_month"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_year_month" />

    <TextView
        android:id="@+id/textview1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pretendard_regular"
        android:text="지출"
        android:textColor="#464646"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_payment_data"
        app:layout_constraintStart_toStartOf="@+id/tv_year_month"
        app:layout_constraintTop_toTopOf="@+id/tv_payment_data" />

    <TextView
        android:id="@+id/tv_payment_data"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/pretendard_bold"
        android:textColor="#464646"
        android:textSize="20sp"
        app:layout_constraintEnd_toStartOf="@+id/btn_analysis"
        app:layout_constraintStart_toEndOf="@+id/textview1"
        app:layout_constraintTop_toBottomOf="@+id/tv_year_month"
        tools:text="463,000원" />

    <ImageView
        android:id="@+id/btn_analysis"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:background="@drawable/ic_finance_analysis"
        android:fontFamily="@font/pretendard_regular"
        android:text="분석하기"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintDimensionRatio="2.5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_payment_data" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:tabBackground="@color/white"
        app:tabRippleColor="@color/text"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/primary"
        app:tabIndicatorHeight="5dp"
        app:tabIndicatorGravity="bottom"
        app:tabIndicatorFullWidth="true"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/btn_analysis"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/tab_vp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/tab_layout"
        app:layout_constraintStart_toStartOf="@+id/tab_layout"
        app:layout_constraintTop_toBottomOf="@id/tab_layout" />

</androidx.constraintlayout.widget.ConstraintLayout>