<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".home.receipt.fragment.EditReceiptDetailFragment">
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="영수증 상품 목록"
        android:gravity="center"
        android:textColor="@color/text"
        android:textSize="18sp"
        android:letterSpacing="-0.02"
        app:layout_constraintBottom_toBottomOf="@+id/btn_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_back" />

    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleX="-1"
        android:src="@drawable/ic_all_arrow"
        android:padding="16dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_receipt_title_bg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_receipt_title"
                android:layout_marginTop="24dp"
                app:layout_constraintEnd_toEndOf="@+id/iv_background"
                app:layout_constraintStart_toStartOf="@+id/iv_background"
                app:layout_constraintTop_toBottomOf="@+id/tv_total_price" />

            <ImageView
                android:id="@+id/iv_background"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_home_receipt_dash"
                android:layout_marginHorizontal="24dp"
                app:layout_constraintBottom_toBottomOf="@+id/rv_receipt_detail"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/tv_store"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/pretendard_semi_bold"
                android:letterSpacing="-0.02"
                android:textColor="@color/text"
                android:textSize="18sp"
                app:layout_constraintEnd_toEndOf="@+id/iv_background"
                app:layout_constraintStart_toStartOf="@+id/iv_background"
                app:layout_constraintTop_toTopOf="@+id/iv_background"
                tools:text="쿠팡" />

            <TextView
                android:id="@+id/tv_total_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_semi_bold"
                android:letterSpacing="-0.02"
                android:textColor="@color/text"
                android:textSize="18sp"
                app:layout_constraintEnd_toEndOf="@+id/tv_store"
                app:layout_constraintStart_toStartOf="@+id/tv_store"
                app:layout_constraintTop_toBottomOf="@+id/tv_store"
                tools:text="24,100원" />

            <TextView
                android:id="@+id/tv_title_product_name"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:fontFamily="@font/pretendard_semi_bold"
                android:letterSpacing="-0.02"
                android:text="상품명"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:gravity="center"
                app:layout_constraintHorizontal_weight="7"
                app:layout_constraintBottom_toBottomOf="@+id/iv_receipt_title_bg"
                app:layout_constraintEnd_toStartOf="@+id/tv_title_unit_price"
                app:layout_constraintStart_toStartOf="@+id/iv_receipt_title_bg"
                app:layout_constraintTop_toTopOf="@+id/iv_receipt_title_bg" />

            <TextView
                android:id="@+id/tv_title_unit_price"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:fontFamily="@font/pretendard_semi_bold"
                android:letterSpacing="-0.02"
                android:text="단가"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:gravity="center"
                app:layout_constraintHorizontal_weight="3"
                app:layout_constraintEnd_toStartOf="@+id/tv_title_count"
                app:layout_constraintBottom_toBottomOf="@+id/iv_receipt_title_bg"
                app:layout_constraintStart_toEndOf="@+id/tv_title_product_name"
                app:layout_constraintTop_toTopOf="@+id/iv_receipt_title_bg" />

            <TextView
                android:id="@+id/tv_title_count"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:fontFamily="@font/pretendard_semi_bold"
                android:letterSpacing="-0.02"
                android:text="수량"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:gravity="center"
                app:layout_constraintHorizontal_weight="2"
                app:layout_constraintEnd_toStartOf="@+id/tv_title_category"
                app:layout_constraintBottom_toBottomOf="@+id/iv_receipt_title_bg"
                app:layout_constraintStart_toEndOf="@+id/tv_title_unit_price"
                app:layout_constraintTop_toTopOf="@+id/iv_receipt_title_bg" />

            <TextView
                android:id="@+id/tv_title_category"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:fontFamily="@font/pretendard_semi_bold"
                android:letterSpacing="-0.02"
                android:text="카테고리"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:gravity="center"
                app:layout_constraintHorizontal_weight="4"
                app:layout_constraintEnd_toEndOf="@+id/iv_receipt_title_bg"
                app:layout_constraintBottom_toBottomOf="@+id/iv_receipt_title_bg"
                app:layout_constraintStart_toEndOf="@+id/tv_title_count"
                app:layout_constraintTop_toTopOf="@+id/iv_receipt_title_bg" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_receipt_detail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginVertical="16dp"
                android:nestedScrollingEnabled="false"

                app:layout_constraintEnd_toEndOf="@+id/iv_receipt_title_bg"
                app:layout_constraintStart_toStartOf="@+id/iv_receipt_title_bg"
                app:layout_constraintTop_toBottomOf="@+id/iv_receipt_title_bg"/>

            <Button
                android:id="@+id/btn_confirm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_all_btn"
                android:letterSpacing="-0.02"
                android:text="수정하기"
                android:textColor="@color/white"
                android:textSize="@dimen/btn_text_size"
                android:layout_marginVertical="36dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/iv_background"
                app:layout_constraintStart_toStartOf="@+id/iv_background"
                app:layout_constraintTop_toBottomOf="@+id/iv_background" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>