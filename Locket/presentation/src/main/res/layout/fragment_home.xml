<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:paddingHorizontal="24dp"
    android:paddingTop="16dp"
    tools:context=".home.HomeFragment">

    <ImageView
        android:id="@+id/logo_locket"
        android:layout_width="108dp"
        android:layout_height="34dp"
        android:src="@drawable/logo_home_locket"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ic_notification"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:src="@drawable/ic_home_bell_off"
        app:layout_constraintBottom_toBottomOf="@+id/ic_profile"
        app:layout_constraintEnd_toStartOf="@+id/ic_profile"
        app:layout_constraintTop_toTopOf="@+id/ic_profile" />

    <ImageView
        android:id="@+id/ic_profile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:paddingVertical="4dp"
        android:src="@drawable/ic_home_profile"
        app:layout_constraintBottom_toBottomOf="@+id/logo_locket"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/logo_locket" />

    <TextView
        android:id="@+id/tv_user_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:fontFamily="@font/pretendard_bold"
        android:letterSpacing="-0.02"
        android:textColor="@color/text"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo_locket"
        tools:text="은주님" />

    <TextView
        android:id="@+id/tv_budget_ai_feedback"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pretendard_bold"
        android:letterSpacing="-0.02"
        android:textColor="@color/primary"
        android:textSize="24sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintEnd_toEndOf="@+id/ic_profile"
        app:layout_constraintStart_toStartOf="@+id/tv_user_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_user_name"
        tools:text="목표 소비 금액 70% 달성 🎯" />

    <ImageView
        android:id="@+id/iv_payment_card_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_home_shadow_card"
        app:layout_constraintDimensionRatio="3.2123"
        app:layout_constraintEnd_toEndOf="@+id/tv_budget_ai_feedback"
        app:layout_constraintStart_toStartOf="@+id/tv_budget_ai_feedback"
        app:layout_constraintTop_toBottomOf="@+id/tv_budget_ai_feedback" />

    <ImageView
        android:id="@+id/iv_payment_icon_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:background="@drawable/bg_home_icon"
        app:layout_constraintBottom_toTopOf="@+id/tv_payment_feedback"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintHeight_percent="0.057"
        app:layout_constraintStart_toStartOf="@+id/iv_payment_card_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_payment_card_bg" />

    <ImageView
        android:id="@+id/iv_payment_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_home_payment"
        app:layout_constraintBottom_toBottomOf="@+id/iv_payment_icon_bg"
        app:layout_constraintEnd_toEndOf="@+id/iv_payment_icon_bg"
        app:layout_constraintStart_toStartOf="@+id/iv_payment_icon_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_payment_icon_bg" />

    <TextView
        android:id="@+id/tv_payment_data"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:fontFamily="@font/pretendard_semi_bold"
        android:letterSpacing="-0.02"
        android:textColor="@color/text"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/tv_payment_title"
        app:layout_constraintEnd_toStartOf="@+id/btn_analysis"
        app:layout_constraintStart_toEndOf="@+id/iv_payment_icon_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_payment_icon_bg"
        tools:text="200,000원" />

    <TextView
        android:id="@+id/tv_payment_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:letterSpacing="-0.02"
        android:textColor="@color/text"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_payment_icon_bg"
        app:layout_constraintEnd_toStartOf="@+id/btn_analysis"
        app:layout_constraintStart_toEndOf="@+id/iv_payment_icon_bg"
        app:layout_constraintTop_toBottomOf="@+id/tv_payment_data"
        tools:text="3월에 쓴 돈" />

    <TextView
        android:id="@+id/tv_payment_feedback"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:letterSpacing="-0.02"
        android:maxLines="1"
        android:textColor="@color/text"
        android:textSize="14sp"
        android:ellipsize="end"
        app:layout_constraintBottom_toBottomOf="@+id/iv_payment_card_bg"
        app:layout_constraintEnd_toStartOf="@+id/btn_analysis"
        app:layout_constraintStart_toStartOf="@+id/iv_payment_icon_bg"
        app:layout_constraintTop_toBottomOf="@+id/iv_payment_icon_bg"
        tools:text="지난 달보다 109만원 덜 썼어요" />

    <ImageView
        android:id="@+id/btn_analysis"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        app:layout_constraintDimensionRatio="2.5"
        android:background="@drawable/ic_finance_analysis"
        app:layout_constraintBottom_toBottomOf="@+id/iv_payment_card_bg"
        app:layout_constraintEnd_toEndOf="@+id/iv_payment_card_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_payment_card_bg" />

    <ImageView
        android:id="@+id/iv_budget_card_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_home_shadow_card"
        app:layout_constraintDimensionRatio="3.2123"
        app:layout_constraintEnd_toEndOf="@+id/tv_budget_ai_feedback"
        app:layout_constraintStart_toStartOf="@+id/tv_budget_ai_feedback"
        app:layout_constraintTop_toBottomOf="@+id/iv_payment_card_bg" />

    <ImageView
        android:id="@+id/iv_budget_icon_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:background="@drawable/bg_home_icon"
        app:layout_constraintBottom_toTopOf="@+id/tv_budget_feedback"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintHeight_percent="0.057"
        app:layout_constraintStart_toStartOf="@+id/iv_budget_card_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_budget_card_bg" />

    <ImageView
        android:id="@+id/iv_budget_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_home_budget"
        app:layout_constraintBottom_toBottomOf="@+id/iv_budget_icon_bg"
        app:layout_constraintEnd_toEndOf="@+id/iv_budget_icon_bg"
        app:layout_constraintStart_toStartOf="@+id/iv_budget_icon_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_budget_icon_bg" />

    <TextView
        android:id="@+id/tv_budget_no_goal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:fontFamily="@font/pretendard_medium"
        android:letterSpacing="-0.02"
        android:text="이번 달 목표를 등록해주세요"
        android:textColor="@color/text"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/iv_budget_icon_bg"
        app:layout_constraintEnd_toStartOf="@+id/btn_analysis"
        app:layout_constraintStart_toEndOf="@+id/iv_budget_icon_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_budget_icon_bg" />

    <TextView
        android:id="@+id/tv_budget_data"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:fontFamily="@font/pretendard_semi_bold"
        android:letterSpacing="-0.02"
        android:textColor="@color/text"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/tv_budget_title"
        app:layout_constraintEnd_toEndOf="@+id/iv_budget_card_bg"
        app:layout_constraintStart_toEndOf="@+id/iv_budget_icon_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_budget_icon_bg"
        tools:text="200,000원" />

    <TextView
        android:id="@+id/tv_budget_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:letterSpacing="-0.02"
        android:textColor="@color/text"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_budget_icon_bg"
        app:layout_constraintEnd_toEndOf="@+id/tv_budget_data"
        app:layout_constraintStart_toStartOf="@+id/tv_budget_data"
        app:layout_constraintTop_toBottomOf="@+id/tv_budget_data"
        tools:text="3월 목표 예산" />

    <TextView
        android:id="@+id/tv_budget_feedback"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:letterSpacing="-0.02"
        android:maxLines="1"
        android:textColor="@color/text"
        android:textSize="14sp"
        android:ellipsize="end"
        app:layout_constraintBottom_toBottomOf="@+id/iv_budget_card_bg"
        app:layout_constraintEnd_toEndOf="@+id/tv_budget_data"
        app:layout_constraintStart_toStartOf="@+id/iv_payment_icon_bg"
        app:layout_constraintTop_toBottomOf="@+id/tv_budget_title"
        tools:text="100,000원 남았어요" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_receipt"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_home_receipt"
        app:layout_constraintDimensionRatio="3.7"
        app:layout_constraintEnd_toEndOf="@+id/iv_budget_card_bg"
        app:layout_constraintStart_toStartOf="@+id/iv_budget_card_bg"
        app:layout_constraintTop_toBottomOf="@+id/iv_budget_card_bg">

        <TextView
            android:id="@+id/tv_receipt_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:fontFamily="@font/pretendard_semi_bold"
            android:letterSpacing="-0.02"
            android:text="영수증"
            android:textColor="@color/text"
            android:textSize="16sp"
            app:layout_constraintBottom_toTopOf="@+id/tv_receipt_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tv_receipt_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="-0.02"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:text="내 영수증을 등록해\n소비습관을 분석해보세요!"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tv_receipt_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_receipt_title" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/ic_home_receipt"
            android:clipToPadding="false"
            android:paddingTop="20dp"
            android:scaleType="centerCrop"
            android:layout_marginEnd="4dp"
            app:layout_constraintDimensionRatio="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.3361" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/iv_character_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#94B590"
        android:background="@drawable/bg_home_receipt"
        app:layout_constraintDimensionRatio="3.7"
        app:layout_constraintEnd_toEndOf="@+id/iv_budget_card_bg"
        app:layout_constraintStart_toStartOf="@+id/iv_budget_card_bg"
        app:layout_constraintTop_toBottomOf="@+id/layout_receipt"/>

    <TextView
        android:id="@+id/tv_character_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:fontFamily="@font/pretendard_semi_bold"
        android:letterSpacing="-0.02"
        android:text="캐릭터 키우기"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:gravity="end"
        app:layout_constraintBottom_toTopOf="@+id/tv_character_content"
        app:layout_constraintEnd_toEndOf="@+id/iv_character_bg"
        app:layout_constraintStart_toStartOf="@+id/iv_character_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_character_bg"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tv_character_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:letterSpacing="-0.02"
        android:text="지금 참여하고 기프티콘 받아보세요!"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:gravity="end"
        app:layout_constraintBottom_toBottomOf="@+id/iv_character_bg"
        app:layout_constraintEnd_toEndOf="@+id/tv_character_title"
        app:layout_constraintStart_toStartOf="@+id/tv_character_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_character_title" />

    <ImageView
        android:id="@+id/iv_character"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/image_home_character"
        android:clipToPadding="false"
        android:paddingTop="20dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_character_bg"
        app:layout_constraintDimensionRatio="1.3918"
        app:layout_constraintStart_toStartOf="@+id/iv_character_bg"
        app:layout_constraintWidth_percent="0.3361" />

