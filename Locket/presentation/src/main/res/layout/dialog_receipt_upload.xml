<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:paddingBottom="32dp"
    android:id="@+id/layout">

    <ImageView
        android:id="@+id/btn_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:src="@drawable/ic_all_close"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <android.widget.Button
        android:id="@+id/btn_upload_img"
        android:layout_width="240dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_dialog_btn"
        android:fontFamily="@font/pretendard_medium"
        android:letterSpacing="-0.02"
        android:text="이미지 업로드"
        android:textColor="@color/white"
        android:textSize="@dimen/btn_text_size"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintDimensionRatio="4.154"
        app:layout_constraintBottom_toTopOf="@+id/btn_upload_pdf"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_close"
        app:layout_constraintVertical_chainStyle="spread" />

    <android.widget.Button
        android:id="@+id/btn_upload_pdf"
        android:layout_width="240dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_dialog_btn"
        android:fontFamily="@font/pretendard_medium"
        android:letterSpacing="-0.02"
        android:text="pdf 업로드"
        android:textColor="@color/white"
        android:textSize="@dimen/btn_text_size"
        android:layout_marginVertical="20dp"
        app:layout_constraintDimensionRatio="4.154"
        app:layout_constraintBottom_toTopOf="@+id/btn_camera"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_upload_img" />

    <android.widget.Button
        android:id="@+id/btn_camera"
        android:layout_width="240dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_dialog_btn"
        android:fontFamily="@font/pretendard_medium"
        android:letterSpacing="-0.02"
        android:text="영수증 촬영"
        android:textColor="@color/white"
        android:textSize="@dimen/btn_text_size"
        app:layout_constraintDimensionRatio="4.154"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_upload_pdf" />
</androidx.constraintlayout.widget.ConstraintLayout>